    <Compile Include="..\..\src\OfficeAutoVersion.PowerPoint\PowerPointVersionActions.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\src\OfficeAutoVersion.Common\Ribbon.xml">
      <LogicalName>OfficeAutoVersion.Common.Ribbon.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
